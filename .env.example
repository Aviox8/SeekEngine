# SeekEngine Environment Variables
# Copy this file to .env.local and fill in your actual values

# ──────────────────────────────────────────────────────────────────────────────
# REQUIRED - Application will not function without these
# ──────────────────────────────────────────────────────────────────────────────

# OpenRouter AI API Key
# - Get free key at: https://openrouter.ai (free tier includes many models)
# - Create account, navigate to API keys section
# - Copy API key below
# - Free models enable testing without credits; paid models available too
OPENROUTER_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx

# OpenRouter API Key Pool (optional, alternative to OPENROUTER_API_KEY)
# - Comma- or newline-separated list of keys for round-robin rotation
# - Keys get per-key cooldowns on 429/402/401 errors automatically
# OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL - Fallback web search providers (app works without but with limited search)
# ──────────────────────────────────────────────────────────────────────────────

# SerpAPI Key (Primary web search provider)
# - Get key at: https://serpapi.com
# - Provides real-time Google search results
# - Free tier: 100 requests/month
# - If not set, falls back to Google Custom Search
SERPAPI_KEY=

# Google Custom Search API Key
# - Get key at: https://console.cloud.google.com/
# - Enable Custom Search API for your project
# - Create OAuth 2.0 credentials (create service account or API key)
GOOGLE_SEARCH_API_KEY=

# Google Custom Search Engine ID (CX)
# - Get at: https://cse.google.com/cse/
# - Create new search engine, copy CX value
# - Required only if GOOGLE_SEARCH_API_KEY is set
GOOGLE_SEARCH_CX=

# ──────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────────────────────────────────────

# Public site URL used for OpenRouter attribution (HTTP-Referer header)
# - Set to your production domain when not deploying to seekengine.vercel.app
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Admin secret for the cache monitoring endpoint (GET /api/ai/cache/stats)
# - Set either one, then call the endpoint with: Authorization: Bearer <secret>
# - Leave unset to disable the endpoint entirely (it returns 500 without it)
# CACHE_STATS_SECRET=
# ADMIN_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────────────────────────────────────

# Environment (development/production/test)
# Controlled by Next.js build, usually doesn't need manual setting
# NODE_ENV=development

# ──────────────────────────────────────────────────────────────────────────────
# USAGE & SETUP
# ──────────────────────────────────────────────────────────────────────────────

# 1. Copy this file (cp .env.example .env.local)
# 2. Get OpenRouter API key (REQUIRED) from https://openrouter.ai
# 3. (Optional) Get SerpAPI or Google Search credentials for better search
# 4. Fill in the values above
# 5. Create account at OpenRouter if needed - free tier works for development
# 6. Run: npm run dev
#
# The app will gracefully degrade if optional search providers aren't configured:
# - If SerpAPI is missing: Uses Google Custom Search
# - If both missing: Search functionality limited to local fallback
# - AI features work with just OPENROUTER_API_KEY

# ──────────────────────────────────────────────────────────────────────────────
# SECURITY NOTES
# ──────────────────────────────────────────────────────────────────────────────

# - Never commit .env.local to version control
# - .env.local is in .gitignore by default
# - API keys in this file are only for local development
# - On Vercel, set environment variables in project settings (never in .env files)
# - Regenerate API keys if accidentally exposed publicly
