# SeekEngine Environment Variables
# Copy this file to .env.local and fill in your actual values

# ──────────────────────────────────────────────────────────────────────────────
# REQUIRED - Application will not function without these
# ──────────────────────────────────────────────────────────────────────────────

# OpenRouter AI API Key
# - Get free key at: https://openrouter.ai (free tier includes many models)
# - Create account, navigate to API keys section
# - Copy API key below
# - Free models enable testing without credits; paid models available too
OPENROUTER_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx

# OpenRouter API Key Pool (optional, alternative to OPENROUTER_API_KEY)
# - Comma- or newline-separated list of keys for round-robin rotation
# - Keys get per-key cooldowns on 429/402/401 errors automatically
# OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2

# OpenRouter Model (optional)
# - Defaults to the free router: openrouter/free (OpenRouter picks a free model per request)
# - Set to a specific model ID (e.g. openai/gpt-oss-120b:free) to pin one
# OPENROUTER_MODEL=openrouter/free

# Ollama Cloud (optional, answer provider #2 — used when OpenRouter fails)
# - OpenAI-compatible API at https://ollama.com/v1
# - Get a key at https://ollama.com (API keys settings)
# - Pick a cloud model from https://ollama.com/search?c=cloud
# OLLAMA_API_KEY=your_ollama_cloud_key
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_MODEL=gemma4:31b

# Exa (optional, answer provider #3 and search/grounding provider)
# - Used for answers only when OpenRouter AND Ollama fail
# - Also used as a search provider when SerpAPI/Google CSE are missing or failing
# - Get a key at https://dashboard.exa.ai
# EXA_API_KEY=your_exa_key
# EXA_ANSWER_MODEL=exa-fast

# Answer provider fallback order:
#   OpenRouter (openrouter/free) -> Ollama Cloud -> Exa Answer -> local synthesis
# Search provider fallback order:
#   SerpAPI -> Google Custom Search -> Exa -> DuckDuckGo (keyless scrape, last resort)

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL - Fallback web search providers (app works without but with limited search)
# ──────────────────────────────────────────────────────────────────────────────

# SerpAPI Key (Primary web search provider)
# - Get key at: https://serpapi.com
# - Provides real-time Google search results
# - Free tier: 100 requests/month
# - If not set, falls back to Google Custom Search
SERPAPI_KEY=

# Google Custom Search API Key
# - Get key at: https://console.cloud.google.com/
# - Enable Custom Search API for your project
# - Create OAuth 2.0 credentials (create service account or API key)
GOOGLE_SEARCH_API_KEY=

# Google Custom Search Engine ID (CX)
# - Get at: https://cse.google.com/cse/
# - Create new search engine, copy CX value
# - Required only if GOOGLE_SEARCH_API_KEY is set
GOOGLE_SEARCH_CX=

# ──────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────────────────────────────────────

# Public site URL used for OpenRouter attribution (HTTP-Referer header)
# - Set to your production domain when not deploying to seekengine.vercel.app
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Admin secret for the cache monitoring endpoint (GET /api/ai/cache/stats)
# - Set either one, then call the endpoint with: Authorization: Bearer <secret>
# - Leave unset to disable the endpoint entirely (it returns 500 without it)
# CACHE_STATS_SECRET=
# ADMIN_SECRET=

# Bearer secret for /api/cron/redis-warm (keeps the fallback Redis warm; GitHub Actions pings it every 10 minutes)
# Falls back to CACHE_STATS_SECRET or ADMIN_SECRET when unset
# CRON_SECRET=

# Upstash Redis (optional — shared caches and rate limiting across ALL instances)
# - Powers: semantic answer cache, search-context cache, suggestion cache, rate limiting
# - REST over HTTPS: works from the Edge runtime, no TCP driver needed
# - Without it, every cache/rate-limiter falls back to per-instance in-memory
# - Set the memory eviction policy to allkeys-lru in the Upstash dashboard
# - Get credentials at https://console.upstash.com (Redis > Details > REST API)
# UPSTASH_REDIS_REST_URL=https://your-db-name-xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxx

# Fallback/warm Redis — any Upstash-compatible REST endpoint (e.g. Layerbase)
# - Same REST protocol; used when the primary Upstash is unreachable
# - Layerbase instances sleep after 15 minutes idle — /api/cron/redis-warm (GitHub Actions, 10-min interval) keeps one warm
# - Writes are applied to BOTH backends best-effort so the fallback does not drift behind
# LAYERBASE_REDIS_REST_URL=https://your-hostname-xxxxx.upstash.io
# LAYERBASE_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────────────────────────────────────

# Environment (development/production/test)
# Controlled by Next.js build, usually doesn't need manual setting
# NODE_ENV=development

# ──────────────────────────────────────────────────────────────────────────────
# USAGE & SETUP
# ──────────────────────────────────────────────────────────────────────────────

# 1. Copy this file (cp .env.example .env.local)
# 2. Get OpenRouter API key (REQUIRED) from https://openrouter.ai
# 3. (Optional) Get SerpAPI or Google Search credentials for better search
# 4. Fill in the values above
# 5. Create account at OpenRouter if needed - free tier works for development
# 6. Run: npm run dev
#
# The app gracefully degrades if providers aren't configured:
# - Search: SerpAPI -> Google Custom Search -> Exa -> DuckDuckGo (keyless)
# - AI answers: OpenRouter -> Ollama Cloud -> Exa Answer -> local synthesis of sources
# - DuckDuckGo and local synthesis require no keys and work as last resorts

# ──────────────────────────────────────────────────────────────────────────────
# SECURITY NOTES
# ──────────────────────────────────────────────────────────────────────────────

# - Never commit .env.local to version control
# - .env.local is in .gitignore by default
# - API keys in this file are only for local development
# - On Vercel, set environment variables in project settings (never in .env files)
# - Regenerate API keys if accidentally exposed publicly
